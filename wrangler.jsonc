// Cloudflare configuration for Perkly.
// The top level is the LOCAL environment. "staging" and "production" are separate
// Workers with separate databases, so test data never mixes with real customers.
// Replace each REPLACE_WITH_... value with the database_id printed by
// `npx wrangler d1 create ...` (see README). These ids are not secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perkly-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Every 2 minutes: welcome, birthday and special-day messages (lib/server/customer-messages.ts).
  "triggers": { "crons": ["*/2 * * * *"] },
  // Videos go through the Worker so it can answer byte-range requests (needed by Safari on iPhone).
  "assets": { "binding": "ASSETS", "run_worker_first": ["/videos/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perkly-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "staging": {
      "name": "perkly-staging",
      // Keep plain-text variables added in the Cloudflare dashboard (e.g. PLATFORM_ADMIN_EMAILS).
      // Without this, every deploy deletes them. Secrets are never affected.
      "keep_vars": true,
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/2 * * * *"] },
      // Not secret: the Google Wallet issuer id is visible in every "save to wallet" link.
      "vars": {
        "GOOGLE_WALLET_ISSUER_ID": "3388000000023227862",
        // The console added the issuer id in front of "3388000000023227862.perkly_loyalty".
        "GOOGLE_WALLET_CLASS_ID": "3388000000023227862.3388000000023227862.perkly_loyalty"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "perkly-staging",
          "database_id": "04914039-e15e-4f9a-a5d1-a20dd333fda4",
          "migrations_dir": "drizzle"
        }
      ]
    },
    "production": {
      "name": "perkly",
      "keep_vars": true,
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/2 * * * *"] },
      // Same Google Wallet issuer and class as staging (one issuer account). Not secret.
      "vars": {
        "GOOGLE_WALLET_ISSUER_ID": "3388000000023227862",
        "GOOGLE_WALLET_CLASS_ID": "3388000000023227862.3388000000023227862.perkly_loyalty"
      },
      // Your own domain. Works once perkly.shop is active in the same Cloudflare account.
      "routes": [
        { "pattern": "perkly.shop", "custom_domain": true },
        { "pattern": "www.perkly.shop", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "perkly-production",
          "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
