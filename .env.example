# Local settings for `npm run dev` / `npm run preview`.
# Copy this file to `.dev.vars` (same folder). Never commit .dev.vars.
# For staging/production, set secrets with:  npx wrangler secret put SIGNUP_CODE --env staging

# Optional: if set, creating a new business-owner account requires this code.
SIGNUP_CODE=

# Optional: comma-separated emails that can open /admin (platform overview).
PLATFORM_ADMIN_EMAILS=
